# WorkBuddy project data (memory / runtime state — not source)
.workbuddy/

# runtime data (submissions contain user code, regenerated at runtime)
data/

# compiled special-judge artifacts (built on first run)
*.exe
*.o
spj

# Prebuilt tray launcher EXE — a source-built deliverable, keep it in the repo
# so users get a one-click launcher without needing a compiler.
!local_oj_launcher.exe

# Launcher build objects / throwaway test helpers (regenerated by build scripts)
launcher/*.o
launcher/test_kill.cpp
launcher/test_kill.exe

# dependencies (this project ships zero npm deps, guard anyway)
node_modules/

# logs
*.log
